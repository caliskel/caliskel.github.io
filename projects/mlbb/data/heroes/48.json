{"id": 48, "name": "Diggie", "splash": "https://static.wikia.nocookie.net/mobile-legends/images/1/17/Hero481-portrait.png/revision/latest?cb=20241021141804", "cls": ["Support", ""], "specialty": ["Guard", "Poke"], "difficulty": "50", "stats": ["40", "40", "20", "50"], "lanes": ["Roam", ""], "story": "The owl scholar who can control time.", "skills": [{"name": "Young Again", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_c925354be703b164f4cb1e334f7f0999.png", "tag": [{"tagid": 62, "tagname": "Buff", "tagrgb": "79,156,184"}], "cdcost": "", "desc": "Upon death, Diggie reverses time and turns back to egg form, in which he can continue to move around and gains a new set of skills. He cannot be targeted in egg form and will revive after a period of time."}, {"name": "Auto Alarm Bomb", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_c86c657882cc6e1d60d78de99684630b.png", "tag": [{"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}, {"tagid": 22, "tagname": "Slow", "tagrgb": "205,93,109"}], "cdcost": "CD: 8   Mana Cost: 70", "desc": "Diggie flings an owl alarm to the target location that remains stationary for 25s or until it reacts to the first enemy in range, chasing them and exploding upon collision. The explosion deals 350<span style=\"color:#62f8fe\"> (+100% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies hit and slows them by 30%.\n\nDiggie gains 2 stacks of <span style=\"color:#a6aafb\">Dangerous Sparks</span> each time an enemy hero is hit by the explosion (up to 60 stacks), each stack increasing the skill's damage by 1%. He loses half the stacks upon death, but can gain 1 stack of <span style=\"color:#a6aafb\">Dangerous Sparks</span> each time his skill hits an enemy hero when in egg form.\n\nUp to 5 owl alarms can exist at the same time."}, {"name": "Reverse Time", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_89a503e45d0aa3d3118f3bf9860f7793.png", "tag": [{"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}, {"tagid": 33, "tagname": "Damage", "tagrgb": "199,121,85"}], "cdcost": "CD: 15   Mana Cost: 90", "desc": "Diggie marks the target enemy hero for 4s and pulls them back to their previous location after the duration ends, dealing 150<span style=\"color:#62f8fe\"> (+100% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> and briefly slowing them by 80%.\n\nIf the enemy moves out of the circle, the pull will be triggered early."}, {"name": "Time Journey", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_51ad0888fa262bf92b3cadf75b7d371c.png", "tag": [{"tagid": 42, "tagname": "CC Immune", "tagrgb": "177,157,96"}, {"tagid": 61, "tagname": "Speed Up", "tagrgb": "79,156,184"}], "cdcost": "CD: 76   Mana Cost: 130", "desc": "Diggie removes all debuffs on nearby allied heroes (including himself) and grants them a 650<span style=\"color:#62f8fe\"> (+300% Total Magic Power)</span> shield and Control Immunity for 2s. He also gains 50% Movement Speed for 0.5s."}], "fullbuilds": [{"items": [{"name": "Magic Boots - Dire Hit", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_0014db918969df3242aa0c02f61ff700.png"}, {"name": "Enchanted Talisman", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_6f55284f79c40b01eec5b151ff791094.png"}, {"name": "Lightning Truncheon", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_ff18dc8e5abef3934886191fe6c161a0.png"}, {"name": "Glowing Wand", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage_92/100_df12c0f80844640a7b40cf64798be915.png"}, {"name": "Holy Crystal", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_25c17fb08406548b8476673ce7fc3078.png"}, {"name": "Divine Glaive", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_ef0ab8d629f06ebd67cf2b65e144f803.png"}], "emblem": {"name": "Mage", "i