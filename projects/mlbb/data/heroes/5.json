{"id": 5, "name": "Nana", "splash": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_ff9412a3d36170f98801085bb32f7bad.png", "cls": ["Mage", ""], "specialty": ["Poke", "Burst"], "difficulty": "10", "stats": ["50", "60", "100", "10"], "lanes": ["Mid Lane", ""], "story": "Little Leonin with no worries.", "skills": [{"name": "Molina's Gift", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_40f1ef3190c16e8bedac960e5d600ae0.png", "tag": [{"tagid": 43, "tagname": "Death Immunity", "tagrgb": "177,157,96"}], "cdcost": "", "desc": "Upon taking fatal damage, Nana removes all debuffs on her and transforms, becoming untargetable and invincible, and gains 30% Movement Speed for 2s. She also recovers 10% Max HP over the duration.\n\nNana can only transform once every 150s and cannot cast skills in the transformed form."}, {"name": "Magic Boomerang", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_54aff0ecbd71fb7e4819568698dfbee6.png", "tag": [{"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}], "cdcost": "CD: 6   Mana Cost: 55", "desc": "Nana hurls her Magic Boomerang in the target direction, dealing damage to enemies hit on its way out and back. The boomerang deals 300<span style=\"color:#62f8fe\"> (+100% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to the first enemy hit. For every additional enemy hit, the damage is reduced by 10% (max reduction of 30%)."}, {"name": "Molina Smooch", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_1551014a72caf56ad15d79a118d767ed.png", "tag": [{"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}, {"tagid": 23, "tagname": "Debuff", "tagrgb": "205,93,109"}], "cdcost": "CD: 12   Mana Cost: 80", "desc": "Nana throws Molina at the target location, dealing 250<span style=\"color:#62f8fe\"> (+50% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies within range and <span style=\"color:#a6aafb\">Transforming</span> enemy heroes hit into small animals.\n\nIf Molina does not hit an enemy hero, she will remain on the ground and chase the nearest enemy hero that comes into range, <span style=\"color:#a6aafb\">Transforming</span> the first enemy hero she touches.\n\n<span style=\"color:#a6aafb\">Transform</span>: Reduces the target's Movement Speed by 50% and Magic Defense by 30% for 1.5s. Transformed heroes cannot attack or use skills."}, {"name": "Molina Blitz", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_32610623c520254cccf0e02a5fac9e44.png", "tag": [{"tagid": 31, "tagname": "Burst", "tagrgb": "199,121,85"}, {"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}], "cdcost": "CD: 36   Mana Cost: 135", "desc": "Nana summons Molina to strike the target area 3 times, each time dealing 440<span style=\"color:#62f8fe\"> (+140% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies within and slowing them by 30% for 1s. Enemies hit consecutively will be stunned for 1s."}], "fullbuilds": [{"items": [{"name": "Corrosion Scythe", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_486be2a89fc7fba69cd82c71d80395af.png"}, {"name": "Demon Hunter Sword", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_4f63658b2ae982d7684b74fca8163014.png"}, {"name": "Golden Staff", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_98d1154b4f017c7b68a4071e3c5e9364.png"}, {"name": "Sky Piercer", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage_92/100_a80160d168038deb13d7d93ec41c8401.png"}, {"name": "Wind of Nature", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_ae8965c4fc07454431c6b1f129c7d1ae.png"}, {"name": "Windtalker", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_9c06b97bb75d8a81e28a87df1ab92193.png"}], "emblem": {"name": "Mage", "icon": "https://akmweb.youngjoygame.com/web