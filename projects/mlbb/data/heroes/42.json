{"id": 42, "name": "Harley", "splash": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_3197492c35e6a2918d9196e4989cfda9.png", "cls": ["Assassin", "Mage"], "specialty": ["Burst", "Poke"], "difficulty": "60", "stats": ["30", "90", "10", "60"], "lanes": ["Jungle", "Mid Lane"], "story": "The young mage whose powers awakened once thrust into danger and who now arrives at the Magic Academy to study.", "skills": [{"name": "Magic Master", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_3e9d943a0869ad60139cba7c8d3a3f0f.png", "tag": [{"tagid": 23, "tagname": "Debuff", "tagrgb": "205,93,109"}], "cdcost": "", "desc": "Harley's mastery of magic allows his Basic Attacks and skills to reduce the enemy's Magic Defense by 2 and increase his Attack Speed by 5%-10% (scales with hero level) for 3s on hit. This effect stacks up to 10 times.\nHarley's Basic Attacks deal 60<span style=\"color:#fba51f\"> (+50% Total Physical Attack)</span> <span style=\"color:#62f8fe\">(+60% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span>."}, {"name": "Poker Trick", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_b585f6e1f81d05d3fe3461082ce1805b.png", "tag": [{"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}, {"tagid": 62, "tagname": "Buff", "tagrgb": "79,156,184"}], "cdcost": "CD: 6   Mana Cost: 55", "desc": "Harley throws 3 waves of cards, 3 cards per wave. Each card deals 130<span style=\"color:#62f8fe\"> (+25% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies.\nAfter the same target is hit 3 time(s), the damage will decay to 50% on subsequent hits."}, {"name": "Space Escape", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_700b842bae382a89c330491ee17ccd3b.png", "tag": [{"tagid": 81, "tagname": "Mobility", "tagrgb": "162,105,198"}, {"tagid": 61, "tagname": "Speed Up", "tagrgb": "79,156,184"}], "cdcost": "CD: 8   Mana Cost: 75", "desc": "Harley blinks in the designated direction, leaving a magic hat at his starting location. His Movement Speed increases by 60% for 2s, then rapidly decays to normal over 4s.\n\n<span style=\"color:#a6aafb\">Use Again</span>: Return to the hat's location."}, {"name": "Deadly Magic", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_0057a5d751c27f6e56d3f105e27e989b.png", "tag": [{"tagid": 31, "tagname": "Burst", "tagrgb": "199,121,85"}, {"tagid": 22, "tagname": "Slow", "tagrgb": "205,93,109"}], "cdcost": "CD: 36   Mana Cost: 120", "desc": "Harley casts a magic ring of fire at an enemy hero, dealing 200<span style=\"color:#62f8fe\"> (+60% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> and a 40% slow effect that decays to 15% after 1.5s. The ring will stay around the target, during which Harley can hit the ring to damage the target. The ring will explode after 4s, dealing <span style=\"color:#7f62fe\">Magic Damage</span> equal to 200<span style=\"color:#62f8fe\"> (+50% Total Magic Power)</span> plus 30% of the damage taken by the target while the ring was active."}], "builds": [{"lane": "JUNGLE", "winRate": 58.3, "pickRate": 4.39, "spell": {"name": "Retribution", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_2cd084a2661c121c347facb060a80377.png"}, "emblem": {"set": "Assassin", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_ae89ce5b37dcd804686133c8d7044430.png", "attrs": ["+14 Adaptive Penetration", "+10 Adaptive Attack", "+3% Movement Speed"]}, "items": [{"name": "Concentrated Energy", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_0bf7aa2a2ab3f03a2f8ac3b9f37dd2d1.png"}, {"name": "Brute Force Breastplate", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_b830fbf0e825c3c46010bf5fbf814767.png"}, {"name": "Genius Wand", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_5f615aa7cb949d4e43d24561b12