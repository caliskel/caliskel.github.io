{"id": 92, "name": "Carmilla", "splash": "https://static.wikia.nocookie.net/mobile-legends/images/3/30/Hero921-portrait.png/revision/latest?cb=20241021142902", "cls": ["Support", "Tank"], "specialty": ["Crowd Control", "Damage"], "difficulty": "40", "stats": ["90", "20", "80", "40"], "lanes": ["Roam", ""], "story": "The girl who became a Blood Demon for love.", "skills": [{"name": "Vampire Pact", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_0260af174d1081a18480eee6545f98a6.png", "tag": [{"tagid": 62, "tagname": "Buff", "tagrgb": "79,156,184"}, {"tagid": 23, "tagname": "Debuff", "tagrgb": "205,93,109"}], "cdcost": "", "desc": "Each time Carmilla deals damage to an enemy hero, she steals 7-11 Physical & Magic Defense (scales with level) from them. The stolen Physical & Magic Defense can stack up to 5 times and lasts 5s. However, Carmilla can only steal defense from the same enemy hero once every 3s."}, {"name": "Crimson Flower", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_51eb6dcde53d88c4994426b112c13fde.png", "tag": [{"tagid": 33, "tagname": "Damage", "tagrgb": "199,121,85"}, {"tagid": 51, "tagname": "Heal", "tagrgb": "89,168,111"}], "cdcost": "CD: 9   Mana Cost: 50", "desc": "Carmilla summons three Crimson Flowers that circle around her for 5s, dealing 65<span style=\"color:#62f8fe\"> (+30% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> each time they hit an enemy and slowing them by 6% for 0.8s (the slow effect stacks up to 30%).\n\nCarmilla recovers 45<span style=\"color:#62f8fe\"> (+21% Total Magic Power)</span> HP each time a Crimson Flower deals damage (only recovers 30% of that amount when hitting minions)."}, {"name": "Bloodbath", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_09ea2e1860eadfae10d82b2059fcef03.png", "tag": [{"tagid": 61, "tagname": "Speed Up", "tagrgb": "79,156,184"}, {"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}], "cdcost": "CD: 11   Mana Cost: 85", "desc": "Carmilla accumulates Bloodbath Energy, gaining 70% Movement Speed that decays over 4.5s.\n\n<span style=\"color:#a6aafb\">Use Again</span>: Carmilla unleashes the accumulated Bloodbath Energy on the target enemy hero or Creep, dealing 150<span style=\"color:#62f8fe\"> (+120% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> and stunning them for 0.6s. The damage and stun duration scale with the accumulation time (up to 100%)."}, {"name": "Curse of Blood", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_f6939ef4e88964687c16976197b94451.png", "tag": [{"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}], "cdcost": "CD: 60   Mana Cost: 150", "desc": "Carmilla casts Curse of Blood on the target location, slowing enemies hit by 50%. After 0.8s, enemies still within the area will take 450<span style=\"color:#62f8fe\"> (+130% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span>, and will be immobilized for 1s, slowed by 30% and linked for 5s.\n\nWhen a linked enemy takes damage or becomes controlled, all the other linked targets take 50% of the damage and become controlled for 100% of the duration. Enemies can move away from one another to break the link."}], "fullbuilds": [{"items": [{"name": "Tough Boots - Encourage", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_570fc1bf3d3e97c6ecc0e65859cfe715.png"}, {"name": "Thunder Belt", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_efae63dc9b3da2bb48dbea60de7c79bc.png"}, {"name": "Dominance Ice", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_1b1672399a7836284effcc60aaddd7de.png"}, {"name": "Athena's Shield", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_d9bb48a8df64ae5065d370adca6a5153.png"}, {"name": "Blade Armor", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_29d321d8fe1089a93f