{"id": 52, "name": "Pharsa", "splash": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_d3de1398e008eadbcc2d711ba43c8c42.png", "cls": ["Mage", ""], "specialty": ["Burst", "Poke"], "difficulty": "30", "stats": ["20", "90", "50", "30"], "lanes": ["Mid Lane", ""], "story": "Crow Princess of Askati Forest.", "skills": [{"name": "Spiritual Unity", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_ebde3d94865d5d05527b4becf8099d61.png", "tag": [{"tagid": 33, "tagname": "Damage", "tagrgb": "199,121,85"}, {"tagid": 22, "tagname": "Slow", "tagrgb": "205,93,109"}], "cdcost": "", "desc": "Every 5s to 8s (scales with <span style=\"color:#a6aafb\">Feathered Air Strike</span> level), Verri enters the <span style=\"color:#a6aafb\">Hunting</span> state. On Pharsa's next attack against an enemy hero, Verri deals extra <span style=\"color:#7f62fe\">Magic Damage</span> equal to 8% of the target's Max HP (+1% per 200 Magic Power) and slows them by 60% for 1s."}, {"name": "Curse of Crow", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_f742fccb6bbc9436b3085a1ee4b740f7.png", "tag": [{"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}, {"tagid": 33, "tagname": "Damage", "tagrgb": "199,121,85"}], "cdcost": "CD: 8   Mana Cost: 60", "desc": "Pharsa unleashes a blast of magic at the target location, dealing 300<span style=\"color:#62f8fe\"> (+120% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies hit and marking them for 4s.\n\nWhen Pharsa hits a marked enemy with a Basic Attack or active skill, the mark is consumed, stunning them for 1s.\n\nMarked enemies will have their positions revealed."}, {"name": "Energy Impact", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_dcf364fc10b2a3ee13ba23a6d56f7987.png", "tag": [{"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}], "cdcost": "CD: 6.5   Mana Cost: 60", "desc": "Pharsa releases magic energy in the target direction, dealing 475<span style=\"color:#62f8fe\"> (+145% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies hit."}, {"name": "Feathered Air Strike", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_f0d9ce0152491c148821703d1e31d802.png", "tag": [{"tagid": 31, "tagname": "Burst", "tagrgb": "199,121,85"}], "cdcost": "CD: 36   Mana Cost: 120", "desc": "<span style=\"color:#a6aafb\">Passive</span>: Each level-up reduces <span style=\"color:#a6aafb\">Spiritual Unity</span>'s interval by 1s.\n<span style=\"color:#a6aafb\">Active</span>: Pharsa takes flight for 8s and bombards the target area, dealing 530<span style=\"color:#62f8fe\"> (+160% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies within. This skill can be cast up to 4 times during the flight."}, {"name": "Wings by Wings", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_566a1f86bd9177eb7b75f0fb0a0c762c.png", "tag": [{"tagid": 72, "tagname": "Morph", "tagrgb": "97,127,198"}, {"tagid": 61, "tagname": "Speed Up", "tagrgb": "79,156,184"}], "cdcost": "CD: 23", "desc": "Pharsa turns into mist and wraps around Verri, gaining 150% extra Movement Speed (decays over time) and the ability to fly over terrain for 5s.\n\nThis state ends immediately when she is controlled or uses a Basic Attack or skill."}], "fullbuilds": [{"items": [{"name": "Arcane Boots - Encourage", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_0fe846a160be710de8f0e40c671282f9.png"}, {"name": "Glowing Wand", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage_92/100_df12c0f80844640a7b40cf64798be915.png"}, {"name": "Lightning Truncheon", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_ff18dc8e5abef3934886191fe6c161a0.png"}, {"name": "Blood Wings", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_8635fde5353c9c68778e2aa59b931844.png"}, {"name":