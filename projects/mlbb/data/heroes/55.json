{"id": 55, "name": "Angela", "splash": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_07643d046530288eb0ff56f13b5e31dd.png", "cls": ["Support", ""], "specialty": ["Guard", "Support"], "difficulty": "50", "stats": ["30", "20", "50", "50"], "lanes": ["Roam", ""], "story": "Artificial human made in Laboratory 1718.", "skills": [{"name": "Smart Heart", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_a43559c89c118c816b669fa49b45e76f.png", "tag": [{"tagid": 61, "tagname": "Speed Up", "tagrgb": "79,156,184"}], "cdcost": "", "desc": "Angela gains 5% extra Movement Speed for 4s each time she casts a skill (up to 20%). When she's attached to an allied hero, the Movement Speed boost is transferred to the allied hero."}, {"name": "Love Waves", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_6f7b56ae09ae397b07ad30d8c94164ae.png", "tag": [{"tagid": 51, "tagname": "Heal", "tagrgb": "89,168,111"}, {"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}], "cdcost": "CD: 2   Mana Cost: 60", "desc": "Angela sends <span style=\"color:#a6aafb\">Love Waves</span> in the target direction, dealing 170<span style=\"color:#62f8fe\"> (+80% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies hit, revealing their positions briefly, and applying a stack of <span style=\"color:#a6aafb\">Lover's Mark</span> (up to 5 stacks). Each stack of <span style=\"color:#a6aafb\">Lover's Mark</span> increases the damage by 20% and slows enemies hit by 8% for 3s.\n<span style=\"color:#a6aafb\">Love Waves</span> also restore 150<span style=\"color:#62f8fe\"> (+75% Total Magic Power)</span> HP to allied heroes hit. Angela can store up to 5 charges of this skill, and the charge time is affected by Cooldown Reduction.\n<span style=\"color:#a6aafb\">When attached to allies, this skill's cooldown is reduced by 50%.</span>"}, {"name": "Puppet-on-a-String", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_0f32c780347021165ab869944f1c981c.png", "tag": [{"tagid": 22, "tagname": "Slow", "tagrgb": "205,93,109"}, {"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}], "cdcost": "CD: 13   Mana Cost: 90", "desc": "Angela launches a <span style=\"color:#a6aafb\">Puppet String</span> at the target enemy (excluding minions), dealing 300<span style=\"color:#62f8fe\"> (+40% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> and gradually slowing them by up to 80%. If the enemy is still connected to the string after 3s, they'll be immobilized for 1.5s and take 450<span style=\"color:#62f8fe\"> (+60% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span>.\n\nEach stack of <span style=\"color:#a6aafb\">Lover's Mark</span> increases the final damage by 20%."}, {"name": "Heartguard", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_d1c3f421da66e26aa3e0d8749f9f39de.png", "tag": [{"tagid": 73, "tagname": "Attach", "tagrgb": "97,127,198"}, {"tagid": 52, "tagname": "Shield", "tagrgb": "89,168,111"}], "cdcost": "CD: 60   Mana Cost: 100", "desc": "Angela begins channeling, applying a 600<span style=\"color:#62f8fe\"> (+150% Total Magic Power)</span> shield to the target allied hero regardless of distance. <span style=\"color:#a6aafb\">Once attached to an ally, the shield remains until detached.</span> After the channeling is complete, she attaches herself to the allied hero for 20s, <span style=\"color:#a6aafb\">during which she can cast skills at zero Mana cost</span>.\nAngela can cast this skill again to cancel the channeling or detach herself from the allied hero. The attaching state will end early if the allied hero is killed."}], "builds": [{"lane": "ROAM", "winRate": 57.0, "pickRate": 12.06, "spell": {"name": "Flicker", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_ab75dcf8db18518977621399c260ea44.png"}, "emblem": {"set": "Support", "icon": "https://akmweb.youngjoygame