{"id": 9, "name": "Akai", "splash": "https://static.wikia.nocookie.net/mobile-legends/images/9/9d/Hero091-portrait.png/revision/latest?cb=20241021140401", "cls": ["Tank", ""], "specialty": ["Guard", "Crowd Control"], "difficulty": "30", "stats": ["90", "30", "90", "30"], "lanes": ["Roam", ""], "story": "The almighty panda hero of Stream Valley.", "skills": [{"name": "Tai Chi", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_889b0e22757b7f4bfbc2cfa4e6b39d98.png", "tag": [{"tagid": 62, "tagname": "Buff", "tagrgb": "79,156,184"}], "cdcost": "", "desc": "Akai gains a 25<span style=\"color:#26e407\"> (+5% Total HP)</span> shield for 4s on each skill cast and marks enemy heroes and Creeps hit by his skills.\n\nAkai's Basic Attacks deal 25<span style=\"color:#26e407\"> (+5% Total HP)</span> extra <span style=\"color:#fb1f1f\">Physical Damage</span> to marked enemies."}, {"name": "Headbutt", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_4c47ec169528dd5f35ee0792fd26fcf8.png", "tag": [{"tagid": 81, "tagname": "Mobility", "tagrgb": "162,105,198"}, {"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}], "cdcost": "CD: 11   Mana Cost: 50", "desc": "Akai charges in the target direction, dealing 300<span style=\"color:#fba51f\"> (+50% Total Physical Attack)</span> <span style=\"color:#fb1f1f\">Physical Damage</span> to enemies along the way. If Akai hits an enemy hero during this process, he'll knock them airborne for 0.5s and be able to roll in the Joystick's direction once.\n\nAkai can cast <span style=\"color:#a6aafb\">Headbutt</span> during <span style=\"color:#a6aafb\">Heavy Spin</span> to quickly adjust his position."}, {"name": "Body Slam", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_57c97caeff255d9d646d4c9b3d100211.png", "tag": [{"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}], "cdcost": "CD: 7   Mana Cost: 50", "desc": "Akai smashes the ground with his body, dealing 270<span style=\"color:#26e407\"> (+6% Total HP)</span> <span style=\"color:#fb1f1f\">Physical Damage</span> to nearby enemies and slowing them by 45% for 2s."}, {"name": "Heavy Spin", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_31701b6b54bacf44d29317ab6ba86f64.png", "tag": [{"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}, {"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}], "cdcost": "CD: 55   Mana Cost: 120", "desc": "Akai removes all debuffs on him and spins for 4s, gaining Slow Immunity while continuously dealing 100<span style=\"color:#fba51f\"> (+50% Total Physical Attack)</span> <span style=\"color:#fb1f1f\">Physical Damage</span> to nearby enemies and knocking them back. Enemy heroes knocked back will knock back other heroes they collide with during the process.\n\nAkai also gradually increases his Movement Speed by 70% over the duration. This skill can only be interrupted by Suppression."}], "fullbuilds": [{"items": [{"name": "Rapid Boots- Conceal", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_2c2d96ba0d12f7ecd4704917e92059bb.png"}, {"name": "Dominance Ice", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_1b1672399a7836284effcc60aaddd7de.png"}, {"name": "Fleeting Time", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage_2_1_60_2/100_1bc2929321c6797f3fd039342cbcbd28.png"}, {"name": "Antique Cuirass", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_f20c5fef57268ccb59a1b818c0b0c769.png"}, {"name": "Athena's Shield", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_d9bb48a8df64ae5065d370adca6a5153.png"}, {"name": "Guardian Helmet", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_fc3154808d5848c4b3d28ea921ee58b9.png"}], "emblem": {"name": "Tank", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_9854de7cfbb30c9fb0002521a274be4c.png"}, "talents": [{"name": "Firmne