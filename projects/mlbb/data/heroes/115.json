{"id": 115, "name": "Xavier", "splash": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_24165af02711d3154a80b97d22042bef.png", "cls": ["Mage", ""], "specialty": ["Damage", "Burst"], "difficulty": "30", "stats": ["20", "100", "80", "30"], "lanes": ["Mid Lane", ""], "story": "Former member of the Knights of Light who's determined to forge a path of his own.", "skills": [{"name": "Transcendence", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_53a9a675ae08ad46997b51645b3972e8.png", "tag": [{"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}, {"tagid": 33, "tagname": "Damage", "tagrgb": "199,121,85"}], "cdcost": "", "desc": "When Xavier's skills hit enemy heroes, he gains 50% Movement Speed for 1.2s (decays over time) and 1 energy charge. At 3 charges, his next skill triggers the Transcendence state.\n\n<span style=\"color:#a6aafb\">Transcendence:</span> In this state, Xavier's Skills 1 and 2 have their cooldowns reduced by 4s, and his Ultimate by 36s. Transcendence lasts 5s and can be extended by 1s each time his skills hit enemies."}, {"name": "Infinite Extension", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_9a8f6f17020d9e302435a06a91a9c299.png", "tag": [{"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}, {"tagid": 22, "tagname": "Slow", "tagrgb": "205,93,109"}], "cdcost": "CD: 6.5   Mana Cost: 45", "desc": "Xavier fires a Mystic Bullet that deals 480<span style=\"color:#62f8fe\"> (+100% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies it passes through.\n\nThe Bullet's flying distance increases each time it hits an enemy or the <span style=\"color:#a6aafb\">Mystic Barrier</span> (up to 5 times)."}, {"name": "Mystic Field", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_328458b4a72433c00a3eca893c267366.png", "tag": [{"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}], "cdcost": "CD: 13   Mana Cost: 80", "desc": "Xavier conjures a <span style=\"color:#a6aafb\">Mystic Barrier</span> that lasts 5s. Enemies that come into contact with the Barrier will take 220<span style=\"color:#62f8fe\"> (+65% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> and be slowed by 50%, while allies will gain 50% extra Movement Speed that decays over 1.2s.\nWhen hit by Xavier's other skills, the Barrier expands into a <span style=\"color:#a6aafb\">Mystic Field</span> for 3s, dealing 220<span style=\"color:#62f8fe\"> (+65% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies within and immobilizing them for 0.8s."}, {"name": "Dawning Light", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_9a6d1b10e75be07744732ede3704a3fb.png", "tag": [{"tagid": 31, "tagname": "Burst", "tagrgb": "199,121,85"}, {"tagid": 62, "tagname": "Buff", "tagrgb": "79,156,184"}], "cdcost": "CD: 56   Mana Cost: 120", "desc": "Xavier unleashes a beam of Mystic magic in the target direction, dealing 600<span style=\"color:#62f8fe\"> (+180% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to all enemies along its path.\n\nOnce cast, he also directly enters the <span style=\"color:#a6aafb\">Transcendence</span> state and resets the state's duration."}], "builds": [{"lane": "MID", "winRate": 56.3, "pickRate": 3.94, "spell": {"name": "Flicker", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_ab75dcf8db18518977621399c260ea44.png"}, "emblem": {"set": "Mage", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_c7febdebe70929be98c7007af3cd0f3a.png", "attrs": ["+30 Magic Power", "+5% Cooldown Reduction", "+8 Magic Penetration"]}, "items": [{"name": "Enchanted Talisman", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_6f55284f79c40b01eec5b151ff791094.png"}, {"name": "Glowing Wand", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage_92/100_df12c0