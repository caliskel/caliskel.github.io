{"id": 78, "name": "Khufra", "splash": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_6541be939404a7e45c28a30bd2f2aa16.png", "cls": ["Tank", ""], "specialty": ["Initiator", "Crowd Control"], "difficulty": "50", "stats": ["90", "20", "100", "50"], "lanes": ["Roam", ""], "story": "Sealed ancient tyrant.", "skills": [{"name": "Spell Curse", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_d94c4dc00e5a3b21b0f57614ea52969d.png", "tag": [{"tagid": 51, "tagname": "Heal", "tagrgb": "89,168,111"}, {"tagid": 33, "tagname": "Damage", "tagrgb": "199,121,85"}], "cdcost": "", "desc": "Khufra activates the Spell Curse left by Esmeralda every 8s, enhancing his next Basic Attack. The enhanced Basic Attack gains extra attack range and deals <span style=\"color:#7f62fe\">Magic Damage</span> equal to <span style=\"color:#fba51f\"> (+120% Total Physical Attack)</span> plus 6% of the target's Max HP. He also slows the target by 30% for 1.5s and heals 8% of his Max HP on hit.\nEach time Khufra applies a control effect to an enemy hero with his skill, the cooldown of <span style=\"color:#a6aafb\">Spell Curse</span> is reduced by 4s."}, {"name": "Tyrant's Revenge", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_e0c4482b792fad7b1613c25e35c87c84.png", "tag": [{"tagid": 81, "tagname": "Mobility", "tagrgb": "162,105,198"}, {"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}], "cdcost": "CD: 15   Mana Cost: 80", "desc": "Khufra pulls the bandage on his arms to launch himself in the specified direction, dealing <span style=\"color:#fb1f1f\">Physical Damage</span> equal to 50 plus 7<span style=\"color:#fba51f\"> (+1.5% Extra Physical Attack)</span>% of his Max HP to all enemy units on the path. When blinking to the furthest distance or encountering a first enemy hero, Khufra will immediately stop, dealing <span style=\"color:#fb1f1f\">Physical Damage</span> equal to 50 plus 7<span style=\"color:#fba51f\"> (+1.5% Extra Physical Attack)</span>% of his Max HP to enemies nearby and then knocking them in the air for up to 1s."}, {"name": "Bouncing Ball", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_fce03edaa914b7eb06de1f158250c7bb.png", "tag": [{"tagid": 22, "tagname": "Slow", "tagrgb": "205,93,109"}, {"tagid": 62, "tagname": "Buff", "tagrgb": "79,156,184"}], "cdcost": "CD: 10   Mana Cost: 70", "desc": "Khufra uses bandage to wrap himself into a magic bouncing ball, increasing his own Physical & Magic Defense by 30%. Enemies trying to use blink skills to move across Khufra will be knocked airborne. \nEach time the magic bouncing ball hits the ground, it will deal <span style=\"color:#7f62fe\">Magic Damage</span> equal to 50 plus 3<span style=\"color:#fba51f\"> (+2% Extra Physical Attack)</span>% of his Max HP to enemies nearby and slow them by 80% for 0.2s."}, {"name": "Tyrant's Rage", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_c789cf5a91de9659a3af64fa42f1c3bd.png", "tag": [{"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}, {"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}], "cdcost": "CD: 50   Mana Cost: 150", "desc": "Khufra pushes back all enemy targets around him toward his front (this skill can only be interrupted by Suppression), dealing 300<span style=\"color:#fba51f\"> (+100% Total Physical Attack)</span> <span style=\"color:#fb1f1f\">Physical Damage</span> and slowing them down for 1.25s. If the enemies are knocked against walls, extra <span style=\"color:#fb1f1f\">Physical Damage</span> equal to 150% of this skill's damage will be inflicted upon them, and they will be stunned, instead of slowed."}], "builds": [{"lane": "ROAM", "winRate": 60.7, "pickRate": 1.41, "spell": {"name": "Flicker", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_ab75dcf8db18518977621399c260ea44.png"}, "emblem": {"set": "Tank", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_9854de7cfbb