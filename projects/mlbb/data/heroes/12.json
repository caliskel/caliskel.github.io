{"id": 12, "name": "Bruno", "splash": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_890739c136c183bc1a128867baf2a357.png", "cls": ["Marksman", ""], "specialty": ["Finisher", "Burst"], "difficulty": "50", "stats": ["20", "60", "20", "50"], "lanes": ["Gold Lane", ""], "story": "The captain of the Eruditio Rangers that protects the city with his amazing football skills.", "skills": [{"name": "Mecha Legs", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_0850ac06412b0171aef0eba541581199.png", "tag": [{"tagid": 62, "tagname": "Buff", "tagrgb": "79,156,184"}], "cdcost": "", "desc": "Bruno gains 2.5% extra Crit Chance each time he deals damage with his skills (up to 8 stacks).\n\nBruno has higher Physical Attack but only gains 80% extra Attack Speed from all sources."}, {"name": "Volley Shot", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_65a5b817dc5f53e082caa8c1def5a9ef.png", "tag": [{"tagid": 33, "tagname": "Damage", "tagrgb": "199,121,85"}, {"tagid": 22, "tagname": "Slow", "tagrgb": "205,93,109"}], "cdcost": "CD: 10   Mana Cost: 60", "desc": "Bruno kicks a Powerball on his next Basic Attack, dealing 100<span style=\"color:#fba51f\"> (+100% Total Physical Attack)</span> <span style=\"color:#fb1f1f\">Physical Damage</span> to the target, slowing them by 30%, and speeding up by 30% for 0.5s.\n\nThe Powerball then bounces back toward Bruno and lands on the ground. He or allied heroes can retrieve the Powerball for another attack and reduce the cooldown of <span style=\"color:#a6aafb\">Flying Tackle</span> by 1s."}, {"name": "Flying Tackle", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_02cfbd7b97612b6aedb46d84a3186ce4.png", "tag": [{"tagid": 81, "tagname": "Mobility", "tagrgb": "162,105,198"}, {"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}], "cdcost": "CD: 7   Mana Cost: 60", "desc": "Bruno makes a slide tackle in the target direction, dealing 140<span style=\"color:#fba51f\"> (+40% Total Physical Attack)</span> <span style=\"color:#fb1f1f\">Physical Damage</span> to enemies in his path and stunning them for 0.5s.\n\nIf the Powerball is bouncing back, Bruno also draws the Powerball toward him."}, {"name": "Worldie", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_0d4558404b2096ecbce8394de5ced030.png", "tag": [{"tagid": 31, "tagname": "Burst", "tagrgb": "199,121,85"}, {"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}], "cdcost": "CD: 38   Mana Cost: 140", "desc": "Bruno kicks his Energy Ball at the target enemy hero, dealing 250<span style=\"color:#fba51f\"> (+83% Total Physical Attack)</span> <span style=\"color:#fb1f1f\">Physical Damage</span> and knocking them back. The Energy Ball then bounces between nearby enemies up to 10 times, each time dealing 150<span style=\"color:#fba51f\"> (+50% Total Physical Attack)</span> <span style=\"color:#fb1f1f\">Physical Damage</span>. Each hit also reduces the enemy's Physical Defense by 4% for 8s (up to 3 stacks)."}], "fullbuilds": [{"items": [{"name": "Haas' Claws", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_139190ae1087ea51233fdbefb1bbbf5b.png"}, {"name": "Warrior Boots", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_1b75a49ef76b0d85c774041463892a29.png"}, {"name": "Berserker's Fury", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_020f531307fa505083b791e6f3093eb4.png"}, {"name": "Great Dragon Spear", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_f6453844f4f326287d4ec7920d2f1044.png"}, {"name": "Windtalker", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_9c06b97bb75d8a81e28a87df1ab92193.png"}, {"name": "Malefic Gun", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage_92/100_05092a6a401a83fd4c6dea577ffd6ed4.png"}], "emblem": {"name": "Assassin", "icon": "https://akmweb.youngjoygame.com/web/svnres/img