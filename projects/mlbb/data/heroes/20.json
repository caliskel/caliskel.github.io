{"id": 20, "name": "Lolita", "splash": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_c58952634f940136c125ba17aad8376e.png", "cls": ["Support", "Tank"], "specialty": ["Guard", "Crowd Control"], "difficulty": "40", "stats": ["100", "10", "90", "40"], "lanes": ["Roam", ""], "story": "Member of the Eruditio Rangers and protector of the Leviathan workshop.", "skills": [{"name": "Noumenon Energy Core", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_8c26e0d0018fb46934ec1e079ddbe695.png", "tag": [{"tagid": 52, "tagname": "Shield", "tagrgb": "89,168,111"}], "cdcost": "", "desc": "Every 3s to 6s (scales with <span style=\"color:#a6aafb\">Noumenon Blast</span> level), the Noumenon Energy Core grants Lolita 20<span style=\"color:#26e407\"> (+2.5% Total HP)</span> <span style=\"color:#62f8fe\">(+20% Total Magic Power)</span> shield. When Lolita casts a skill, the Noumenon Energy Core grants Lolita and nearby allied heroes an extra shield. This shield can stack up to 3 times and lasts 30s."}, {"name": "Power Charge", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_e1554a16e239a56ab24a59ed06542a07.png", "tag": [{"tagid": 81, "tagname": "Mobility", "tagrgb": "162,105,198"}, {"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}], "cdcost": "CD: 10   Mana Cost: 70", "desc": "Lolita dashes in the target direction. Her next Basic Attack within 4s will perform a short dash to the target, dealing 400<span style=\"color:#fba51f\"> (+100% Total Physical Attack)</span> <span style=\"color:#fb1f1f\">Physical Damage</span> and stunning them for 0.5s. This damage is doubled against Minions."}, {"name": "Guardian's Reflection", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_c667899aa7f531fa5b199327be638d54.png", "tag": [{"tagid": 52, "tagname": "Shield", "tagrgb": "89,168,111"}, {"tagid": 33, "tagname": "Damage", "tagrgb": "199,121,85"}], "cdcost": "CD: 15   Mana Cost: 90", "desc": "Lolita raises her shield and reflects all incoming ranged Basic Attacks and <span style=\"color:#a6aafb\">Projectiles</span> in the direction of the shield for 3s. The shield will break after taking 1000<span style=\"color:#26e407\"> (+15% Total HP)</span> damage.\n\nThe damage and effects from the Unique Passives of an attacker's equipment will not apply to the shield and will not be reflected. This skill can be interrupted by high level control effects."}, {"name": "Noumenon Blast", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_139bfe9c5e5ab063c0988222a5a3c456.png", "tag": [{"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}, {"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}], "cdcost": "CD: 55   Mana Cost: 100", "desc": "<span style=\"color:#a6aafb\">Passive</span>: Reduces the interval of <span style=\"color:#a6aafb\">Noumenon Energy Core</span> by 1s each time this skill is upgraded.\n\n<span style=\"color:#a6aafb\">Active</span>: Lolita begins charging for 2s while slowing enemies in a fan-shaped area by 60%. When the charging is complete or is stopped, Lolita slams her hammer on the ground, dealing up to 600<span style=\"color:#fba51f\"> (+100% Total Physical Attack)</span> <span style=\"color:#fb1f1f\">Physical Damage</span> to enemies in the area and stunning them for up to 2s (damage and stun duration scale with charge time).\n\n<span style=\"color:#a6aafb\">Use Again</span>: Lolita immediately stops charging and slams her hammer on the ground."}], "fullbuilds": [{"items": [{"name": "Cursed Helmet", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_f10a5ab8cc0a4df1b9fddcc7566dad0e.png"}, {"name": "Tough Boots - Encourage", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_570fc1bf3d3e97c6ecc0e65859cfe715.png"}, {"name": "Dominance Ice", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_1b1672399a7836284effcc60aaddd7de.png"}, {"name": "Athena's Shield", "icon": 