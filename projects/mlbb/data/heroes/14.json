{"id": 14, "name": "Rafaela", "splash": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_c4d4ab4a6353c0dd1481a59d57d09cdf.png", "cls": ["Support", ""], "specialty": ["Regen", "Guard"], "difficulty": "20", "stats": ["60", "20", "70", "20"], "lanes": ["Roam", ""], "story": "An angel loved and respected by the people of this world.", "skills": [{"name": "Divine Resurrection", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage_2_1_18/100_eb33edd56da79e4dbe8601648e2cb07a.png", "tag": [{"tagid": 62, "tagname": "Buff", "tagrgb": "79,156,184"}], "cdcost": "", "desc": "Rafaela can cast a special skill every 40s. After channeling for 2.5s, she instantly resurrects an ally and increases their Movement Speed by 30% for 5s (taking damage from heroes and Legend Creeps interrupts channeling and puts the skill on base cooldown).\nThis skill's cooldown is increased by 500% of the target's remaining respawn time, capped at 240s. This skill is not affected by Cooldown Reduction."}, {"name": "Light of Retribution", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_e3672153fbf1dbeb4a98243958f9deb7.png", "tag": [{"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}, {"tagid": 22, "tagname": "Slow", "tagrgb": "205,93,109"}], "cdcost": "CD: 5   Mana Cost: 45", "desc": "Rafaela strikes the three nearest enemies with <span style=\"color:#a6aafb\">Light of Retribution</span>, dealing them 225<span style=\"color:#62f8fe\"> (+120% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span>, briefly revealing their positions, and slowing them by 40% for 1.5s. Enemies hit by <span style=\"color:#a6aafb\">Light of Retribution</span> again within 6s will take 20% extra damage (this effect stacks up to 3 times)."}, {"name": "Holy Healing", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_a4ce274e4ea7ccb436e0adfec05457aa.png", "tag": [{"tagid": 51, "tagname": "Heal", "tagrgb": "89,168,111"}, {"tagid": 61, "tagname": "Speed Up", "tagrgb": "79,156,184"}], "cdcost": "CD: 10.5   Mana Cost: 80", "desc": "Rafaela calls upon <span style=\"color:#a6aafb\">Holy Light</span>, recovering 100<span style=\"color:#62f8fe\"> (+35% Total Magic Power)</span> HP for nearby allied heroes, plus an additional 150<span style=\"color:#62f8fe\"> (+65% Total Magic Power)</span> HP for herself and the most injured allied hero in range. She also increases the Movement Speed of nearby allied heroes by 30% and grants Slow Immunity for 1s.\n\nEvery 10 point(s) of Magic Power will add 1% to the Movement Speed bonus."}, {"name": "Holy Baptism", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_70f534ce6bfaa6640646551419211d4c.png", "tag": [{"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}, {"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}], "cdcost": "CD: 38   Mana Cost: 150", "desc": "Rafaela unleashes the true power of <span style=\"color:#a6aafb\">Holy Light</span> in the target direction, dealing 460<span style=\"color:#62f8fe\"> (+120% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies in a line and stunning them for 1.2s."}], "builds": [{"lane": "ROAM", "winRate": 59.7, "pickRate": 5.07, "spell": {"name": "Revitalize", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_3377a32a4db8d4009b37cfdbe29ed586.png"}, "emblem": {"set": "Support", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_3bd7417bce76995285722e25d8ff5ebd.png", "attrs": ["+12% Healing Effect", "+10% Cooldown Reduction", "+6% Movement Speed"]}, "items": [{"name": "Enchanted Talisman", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_6f55284f79c40b01eec5b151ff791094.png"}, {"name": "Flask of the Oasis", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_bd4250e426ca1cf5e7f8a7b0861ad4b1.png"}, {"name": "Oracle", "icon": "https://akmweb.youngjoygame.com/web/svnres