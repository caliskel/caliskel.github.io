{"id": 41, "name": "Gatotkaca", "splash": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_b7a1b7f856deca1644516417db30acb6.png", "cls": ["Tank", "Fighter"], "specialty": ["Crowd Control", "Burst"], "difficulty": "10", "stats": ["90", "30", "90", "10"], "lanes": ["Roam", "Exp Lane"], "story": "Warrior from the Arcadhem universe.", "skills": [{"name": "Steel Bones", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_2bcf1c5dea0b73298389955379bdc6b4.png", "tag": [{"tagid": 62, "tagname": "Buff", "tagrgb": "79,156,184"}, {"tagid": 51, "tagname": "Heal", "tagrgb": "89,168,111"}], "cdcost": "", "desc": "Gatotkaca gains Physical Defense equal to 2% of his lost HP (up to 200). For every 300 damage he takes (calculated before damage reduction), he gains 5 Rage (up to 100).\n\nUpon reaching over 25 Rage, Gatotkaca's next Basic Attack becomes enhanced, consuming all Rage to deal extra <span style=\"color:#7f62fe\">Magic Damage</span> and recover HP. The extra damage scales with his Rage, level, and Magic Power."}, {"name": "Blast Iron Fist", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_14b9b342dddb7cc721b7e93ba38a33ff.png", "tag": [{"tagid": 32, "tagname": "AOE", "tagrgb": "199,121,85"}, {"tagid": 22, "tagname": "Slow", "tagrgb": "205,93,109"}], "cdcost": "CD: 8", "desc": "Gatotkaca slams the ground, creating a shattered zone in the target direction while dealing 200<span style=\"color:#62f8fe\"> (+150% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to enemies within. Enemies in the shattered zone will take 100<span style=\"color:#62f8fe\"> (+20% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> per second and be slowed by 30%."}, {"name": "Unbreakable", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_6c888f8a9fb4daac350896e27d7f49eb.png", "tag": [{"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}, {"tagid": 81, "tagname": "Mobility", "tagrgb": "162,105,198"}], "cdcost": "CD: 12", "desc": "Gatotkaca begins channeling, then sprints in the target direction with a battle cry, taunting enemies on the path to attack him, dealing 200<span style=\"color:#62f8fe\"> (+100% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> for 0.9 - 1.5s. The taunt duration and sprint distance scale with the channel time. Canceling the skill reduces 50% of the remaining cooldown."}, {"name": "Avatar of the Guardian", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_072e55d9347652eb686b7539943887de.png", "tag": [{"tagid": 21, "tagname": "CC", "tagrgb": "205,93,109"}, {"tagid": 81, "tagname": "Mobility", "tagrgb": "162,105,198"}], "cdcost": "", "desc": "Gatotkaca jumps to the target location, dealing 500<span style=\"color:#62f8fe\"> (+300% Total Magic Power)</span> <span style=\"color:#7f62fe\">Magic Damage</span> to nearby enemies and knocking them airborne for 1s. Enemies near the center of the area will be knocked airborne for a longer duration, while enemies on the fringes will be pulled to the center.\n\nThe camera will move with the skill indicator but won't grant extra sight."}], "builds": [{"lane": "ROAM", "winRate": 58.3, "pickRate": 1.55, "spell": {"name": "Revitalize", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_3377a32a4db8d4009b37cfdbe29ed586.png"}, "emblem": {"set": "Tank", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_9854de7cfbb30c9fb0002521a274be4c.png", "attrs": ["+500 Extra Max HP", "+10 Extra Physical Defense", "+10 Extra Magic Defense", "+4 HP Regen"]}, "items": [{"name": "Thunder Belt", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_efae63dc9b3da2bb48dbea60de7c79bc.png"}, {"name": "Dominance Ice", "icon": "https://akmweb.youngjoygame.com/web/svnres/img/mlbb/homepage/100_1b1672399a7836284effcc60aaddd7de.png"}, {"name": "Chastise Pauldron", "icon": "https://ak